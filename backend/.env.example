# ==============================================================================
# CApp Backend - Variáveis de Ambiente de Desenvolvimento (.env.example)
# ==============================================================================
# Uso local: copie para .env no diretório backend/ ou forneça via shell/IDE.
# NUNCA insira dados de homologação ou produção neste arquivo.
# ==============================================================================

# Ambiente de execução
APP_ENV=development

# Conexão com o banco de dados PostgreSQL local (obrigatória)
DATABASE_URL=postgresql://capp:change-me@localhost:5432/capp

# Projeto esperado nos ID tokens Firebase (placeholder; obrigatório no backend)
FIREBASE_PROJECT_ID=seu-project-id

# Configuração do listener HTTP
SERVER_HOST=0.0.0.0
BACKEND_PORT=3000

# Nível de log / tracing
RUST_LOG=info

# Segredos privados (fornecidos apenas em homologação/produção via gerenciador seguro)
# JWT_SECRET=dev_insecure_jwt_secret_minimum_32_characters_for_local_only
# FIREBASE_SERVICE_ACCOUNT_KEY=
