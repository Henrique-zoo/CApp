# ==============================================================================
# CApp - Template de Variáveis de Ambiente (.env.example)
# ==============================================================================
# ATENÇÃO:
# 1. Este arquivo serve exclusivamente como modelo para desenvolvimento local (dev).
# 2. NUNCA insira segredos reais de produção ou homologação neste arquivo.
# 3. NUNCA versione arquivos .env contendo dados reais no Git.
# 4. Para uso local, copie este arquivo para .env: cp .env.example .env
# ==============================================================================

# Ambiente de execução (development | staging | production)
APP_ENV=development

# Configuração do PostgreSQL (Compose e ambiente local)
POSTGRES_DB=capp
POSTGRES_USER=capp
POSTGRES_PASSWORD=capp
POSTGRES_PORT=5432

# URL de conexão do banco de dados (para execução do backend no host via Cargo)
# No Compose, esta variável é construída automaticamente a partir dos valores acima.
DATABASE_URL=postgres://capp:capp@localhost:5432/capp

# Configuração do Servidor Backend
SERVER_HOST=0.0.0.0
BACKEND_PORT=3000
RUST_LOG=info

# ------------------------------------------------------------------------------
# Segredos Privados Futuros / Integrações Backend (Entrega I01 - Acesso e meu CA)
# ATENÇÃO: NUNCA embarcar estas variáveis no aplicativo mobile (APK/IPA/bundle).
# Em homologação e produção, estas variáveis DEVEM ser fornecidas via cofre de segredos.
# ------------------------------------------------------------------------------
# JWT_SECRET=dev_insecure_jwt_secret_minimum_32_characters_for_local_only
# FIREBASE_SERVICE_ACCOUNT_KEY=
# MICROSOFT_CLIENT_SECRET=
