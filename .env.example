POSTGRES_DB=capp
POSTGRES_USER=capp
POSTGRES_PASSWORD=change-me
# Somente para execução do binário fora do Compose, com PostgreSQL local.
DATABASE_URL=postgresql://capp:change-me@localhost:5432/capp

BACKEND_PORT=8443
CAPP_HTTPS_BIND=127.0.0.1
BACKEND_TLS_CERT_FILE=./.tls/backend.crt
BACKEND_TLS_KEY_FILE=./.tls/backend.key
BACKEND_TLS_HEALTH_HOST=localhost
# Defina quando o certificado do servidor tiver sido emitido por uma CA.
# BACKEND_TLS_HEALTH_CA_FILE=./.tls/ca.pem
# Devem corresponder ao dono da chave privada montada no container.
BACKEND_UID=1000
BACKEND_GID=1000
RUST_LOG=info

FIREBASE_PROJECT_ID=seu-project-id

# App Check: número do projeto (não é o project ID) e App IDs permitidos.
# Valores públicos usados pelo Android em mobile/lib/firebase_options.dart.
FIREBASE_PROJECT_NUMBER=13241645392
FIREBASE_APP_CHECK_APP_IDS=1:13241645392:android:f9927433685734e2a45455
